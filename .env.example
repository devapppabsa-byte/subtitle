# Ejemplo de configuración por variables de entorno (Fase 1).
# Copiar a `.env` y ajustar. El código lee con prefijo SUBTITLE_ (ver app/settings/config.py).
# La prioridad es: JSON (--config / SUBTITLE_CONFIG) <- variables de entorno <- CLI.

SUBTITLE_CONFIG=
SUBTITLE_LOG_LEVEL=INFO

# Audio: synthetic | wav | microphone | monitor
# monitor = salida del sistema (loopback); device = índice, subcadena o vacío (auto).
SUBTITLE_AUDIO_SOURCE=monitor
SUBTITLE_AUDIO_DEVICE=
SUBTITLE_AUDIO_PATH=

# Voz: scripted | groq | faster-whisper | deepgram | assemblyai | openai
SUBTITLE_SPEECH_ENGINE=scripted
SUBTITLE_SPEECH_MODEL=base
SUBTITLE_SPEECH_LANGUAGE=en

# Traducción: passthrough | mapping | groq | openai | anthropic | openrouter
SUBTITLE_TRANSLATION_ENGINE=mapping
SUBTITLE_TRANSLATION_MODEL=
SUBTITLE_SOURCE_LANGUAGE=en
SUBTITLE_TARGET_LANGUAGE=es
# Varios destinos del mismo fragmento (coma-separado, p. ej. es,fr,de):
SUBTITLE_TARGET_LANGUAGES=
SUBTITLE_TRANSLATION_MODEL=
SUBTITLE_TRANSLATION_TIMEOUT=30
SUBTITLE_TRANSLATION_RETRIES=2
SUBTITLE_TRANSLATION_PARALLEL=false
SUBTITLE_TRANSLATION_CACHE=512

# Voz en la nube (ventanas batch):
SUBTITLE_SPEECH_WINDOW=8
SUBTITLE_SPEECH_OVERLAP=2
SUBTITLE_SPEECH_TIMEOUT=60
SUBTITLE_SPEECH_RETRIES=2

# Observabilidad (Fase 7):
SUBTITLE_LATENCY_LOG=
SUBTITLE_POLL_MS=100

# Overlay: console | qt
SUBTITLE_OVERLAY_RENDERER=console

# Claves de proveedores (a partir de Fase 9 se guardan CIFRADAS en
# ~/.config/traductor-tiempo-real/keys.db desde el panel "Motor IA"; este .env
# solo se usa para migrar claves antiguas y se elimina tras importarlas).
# GROQ_API_KEY=        # Voz (whisper) + traducción; nivel gratuito
# OPENAI_API_KEY=      # Traducción
# ANTHROPIC_API_KEY=   # Traducción (Claude)
# OPENROUTER_API_KEY=  # Traducción (incluye modelos :free)
# GEMINI_API_KEY=      # Traducción (Google Gemini, nivel gratuito)
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=
# DEEPL_API_KEY=
